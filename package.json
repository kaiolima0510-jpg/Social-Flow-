{
  "name": "socialflow-ultra-blindado-v7.2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx watch --env-file=.env server.ts\" \"vite\" --names \"backend,frontend\" --prefix-colors \"cyan,magenta\"",
    "backend": "tsx watch --env-file=.env server.ts",
    "frontend": "vite",
    "start": "node --max-old-space-size=400 dist/server.js",
    "build": "vite build && npx esbuild server.ts --bundle --platform=node --target=node20 --outfile=dist/server.js --format=esm --external:express --external:@supabase/supabase-js --external:@google/genai",
    "preview": "vite preview",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "@supabase/supabase-js": "^2.110.8",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "lucide-react": "^0.554.0",
    "pg": "^8.22.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
