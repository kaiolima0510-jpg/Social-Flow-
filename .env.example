# =============================================================================
# SOCIAL FLOW — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para ".env" e preencha os valores abaixo.
# ATENÇÃO: O arquivo ".env" NÃO deve ser commitado no Git. (já está no .gitignore)
# =============================================================================

# ------------------------------------------------------------------------------
# DOMÍNIO DA APLICAÇÃO
# Ex: socialflow.meudominio.com
# ------------------------------------------------------------------------------
DOMAIN=seu.dominio.com

# ------------------------------------------------------------------------------
# SUPABASE — Banco de Dados (Auto-hospedado via setup.sh)
# A URL será: https://<DOMAIN>/supabase
# As chaves abaixo são geradas automaticamente pelo setup.sh.
# Se você já tem um Supabase rodando, cole as chaves aqui manualmente.
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://seu.dominio.com/supabase
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# BACKEND — URL pública da aplicação
# Normalmente é o mesmo domínio principal (sem /supabase)
# ------------------------------------------------------------------------------
PORT=3000
VITE_BACKEND_URL=https://seu.dominio.com

# ------------------------------------------------------------------------------
# AUTENTICAÇÃO E SEGURANÇA
# ------------------------------------------------------------------------------
# Defina uma senha mestre para bloquear o acesso público à ferramenta.
# Se deixado em branco, a ferramenta ficará aberta (sem login).
APP_PASSWORD=sua_senha_secreta_aqui

# ------------------------------------------------------------------------------
# APIs DE TERCEIROS
# ------------------------------------------------------------------------------

# Google Gemini API Key (obrigatório para funcionalidades de IA)
# Obtenha em: https://aistudio.google.com/app/apikey
API_KEY=your_gemini_api_key_here

# Token secreto para verificação do Webhook do Facebook/Meta (pode ser qualquer string)
FB_WEBHOOK_VERIFY_TOKEN=socialflow_secret_token

# Senha secund�ria (Opcional - Workspace separado)
FRIEND_PASSWORD=
